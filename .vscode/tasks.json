{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "Build bmi_calculator",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "${workspaceFolder}\\src\\main.cpp",
        "${workspaceFolder}\\src\\app.cpp",
        "${workspaceFolder}\\src\\file_manager.cpp",
        "${workspaceFolder}\\src\\ui.cpp",
        "${workspaceFolder}\\src\\user.cpp",
        "${workspaceFolder}\\src\\bmi_service.cpp",
        "-I",
        "${workspaceFolder}\\headers",
        "-o",
        "${workspaceFolder}\\build\\bmi_calculator.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build all bmi-calculator source files"
    }
  ],
  "version": "2.0.0"
}